rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tests for these rules live in rules-tests/ — run them after any change.

    function isSignedIn() {
      return request.auth != null;
    }

    // Check that a field hasn't changed in an update
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // An update may touch only the listed fields (compares values, so a full-doc
    // set() that leaves other fields as they were still passes).
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isVerifiedCelebrity(user) {
      return user.role == 'CELEBRITY'
        && user.get('verificationStatus', null) == 'VERIFIED';
    }

    // ── users/{userId} ────────────────────────────────────────────────────────
    //
    // Any signed-in user can read profiles (celebrity discovery, fan profile pages).
    // Users can create and update only their own document:
    //   - `role` is set on create; the only change allowed afterwards is the one-way
    //     FAN → CELEBRITY switch made on the profile-setup screen (registration always
    //     creates a FAN). Being a CELEBRITY grants nothing on its own — anything that
    //     matters is gated on `verificationStatus`.
    //   - `verificationStatus` and the reputation/counter fields (rating, totals,
    //     collectionCount) start empty and can only be set by a backend process
    //     (Cloud Function / Admin SDK). Updates are limited to the fields a user
    //     legitimately edits.
    function hasNoStats(data) {
      return data.get('verificationStatus', null) == null
        && data.get('rating', null) in [null, 0]
        && data.get('totalAutographs', null) in [null, 0]
        && data.get('totalPurchases', null) in [null, 0]
        && data.get('collectionCount', null) in [null, 0];
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.role in ['FAN', 'CELEBRITY']
        && hasNoStats(request.resource.data);

      allow update: if request.auth.uid == userId
        && onlyChanges(['displayName', 'bio', 'profileImageUrl', 'role', 'category',
                        'autographPrice', 'isAcceptingRequests', 'socialLinks',
                        'favoriteCategories'])
        && (unchanged('role')
          || (resource.data.role == 'FAN' && request.resource.data.role == 'CELEBRITY'))
        && (request.resource.data.get('autographPrice', null) == null
          || request.resource.data.autographPrice >= 0);

      // Account deletion (Play requires it in the app). The app re-authenticates the user,
      // writes account_deletions/{uid}, then deletes this doc and the Auth account.
      allow delete: if request.auth.uid == userId;

      // ── users/{userId}/blocked/{blockedId} ──────────────────────────────────
      // A user's own block list (Play's user-generated content policy requires
      // in-app blocking). Private to its owner. Blocking hides the other user's
      // photos, listings and profile in the app; a celebrity's block also stops
      // that fan from sending new requests (see autograph_requests create).
      match /blocked/{blockedId} {
        allow read, delete: if request.auth.uid == userId;
        allow create, update: if request.auth.uid == userId
          && blockedId != userId
          && request.resource.data.keys().hasOnly(['displayName', 'blockedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.blockedAt == request.time;
      }
    }

    // ── reports/{reportId} ────────────────────────────────────────────────────
    // Reports of objectionable photos, users or requests (Play's user-generated
    // content policy requires in-app reporting). Write-only from the app: the
    // reporter can't read, change or delete a report. Reviewed in the Firebase
    // Console (README: "Reports and blocks").
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['reporterId', 'targetType', 'targetId',
                                                  'targetUserId', 'reason', 'details', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['PHOTO', 'USER', 'REQUEST']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.targetUserId is string
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.reason in ['SPAM', 'HARASSMENT', 'SEXUAL', 'VIOLENCE',
                                            'HATE', 'IMPERSONATION', 'SCAM', 'OTHER']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.createdAt == request.time;
    }

    // ── account_deletions/{userId} ────────────────────────────────────────────
    // Marker the app writes just before an account is deleted, so the owner can finish
    // cleanup (unsold photos, requests) within the 30 days the privacy policy promises.
    // Write-only from the app; read it in the Firebase Console.
    match /account_deletions/{userId} {
      allow create, update: if request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'role', 'requestedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.role is string
        && request.resource.data.requestedAt == request.time;
    }

    // True if `photo` is being signed for an open request addressed to the caller,
    // and is owned by the fan who made it.
    function isFulfillingRequest(photo) {
      return photo.get('requestId', null) is string
        && requestIsOpenFor(
          get(/databases/$(database)/documents/autograph_requests/$(photo.requestId)).data,
          photo.ownerId);
    }

    function requestIsOpenFor(req, ownerId) {
      return req.celebrityId == request.auth.uid
        && req.fanId == ownerId
        && req.status in ['PENDING', 'ACCEPTED', 'IN_PROGRESS'];
    }

    // ── signed_photos/{photoId} ───────────────────────────────────────────────
    //
    // Any signed-in user can read photos (marketplace, feed, profile grids).
    //
    // Only VERIFIED celebrities can create signed photos, as themselves — otherwise
    // anyone could sell an "autograph" under a famous name. Verification is set by
    // the backend (for now: by hand in the Firebase Console).
    //
    // Three update paths, each locked to one actor:
    //
    //   1. CELEBRITY FINISHING A DRAFT — the celebrity named on a DRAFT photo can set
    //      its image URLs and move it to SIGNED. Nothing else, and never once it's
    //      signed (a celebrity can't touch a photo after it's been sold).
    //
    //   2. OWNER LISTING — the current owner can list or delist the photo
    //      (SIGNED ↔ LISTED) and change price/title/description/tags.
    //
    //   3. PURCHASE — any signed-in user other than the owner can "buy" a LISTED
    //      photo: status flips to SOLD and ownerId transfers to the buyer. Only those
    //      two fields change. The app writes this together with the transaction doc
    //      in one Firestore transaction.
    //      ⚠ No payment verification at this layer — move purchaseListing to a
    //        Cloud Function before launch so a real payment gate can be added.
    match /signed_photos/{photoId} {
      allow read: if isSignedIn();

      // The new photo belongs to its celebrity, or — when signed for a request —
      // to the fan who made that request (the celebrity must be the one it was sent to).
      allow create: if isSignedIn()
        && isVerifiedCelebrity(userDoc(request.auth.uid))
        && request.resource.data.celebrityId == request.auth.uid
        && request.resource.data.status in ['DRAFT', 'SIGNED']
        && request.resource.data.id == photoId
        && request.resource.data.get('likeCount', 0) == 0
        && request.resource.data.get('viewCount', 0) == 0
        && (request.resource.data.ownerId == request.auth.uid
          || isFulfillingRequest(request.resource.data));

      allow update: if isSignedIn() && (

        // 1. Celebrity finishing a draft
        (request.auth.uid == resource.data.celebrityId
          && resource.data.status == 'DRAFT'
          && request.resource.data.status in ['DRAFT', 'SIGNED']
          && onlyChanges(['status', 'signedPhotoUrl', 'thumbnailUrl',
                          'originalPhotoUrl', 'signedAt']))

        ||

        // 2. Current owner listing / delisting
        (request.auth.uid == resource.data.ownerId
          && resource.data.status in ['SIGNED', 'LISTED']
          && request.resource.data.status in ['SIGNED', 'LISTED']
          && onlyChanges(['status', 'price', 'title', 'description', 'tags'])
          && (request.resource.data.status != 'LISTED' || request.resource.data.price > 0))

        ||

        // 3. Purchase: LISTED → SOLD, ownership transfers to buyer
        (resource.data.status == 'LISTED'
          && resource.data.ownerId != request.auth.uid
          && request.resource.data.status == 'SOLD'
          && request.resource.data.ownerId == request.auth.uid
          && onlyChanges(['status', 'ownerId']))
      );
    }

    // ── autograph_requests/{requestId} ────────────────────────────────────────
    //
    // Only the fan and the celebrity on a request can read it.
    //
    // Fans create requests; fanId must match the caller so they can't impersonate.
    // Requests can only go to a verified celebrity who is accepting requests and
    // hasn't blocked the fan, at exactly that celebrity's listed price. Initial
    // status must be PENDING.
    //
    // Two update paths (only status, signedPhotoId and updatedAt ever change):
    //   FAN       — can only cancel a PENDING request (PENDING → CANCELLED).
    //   CELEBRITY — drives the workflow: PENDING → ACCEPTED/REJECTED,
    //               ACCEPTED → IN_PROGRESS/COMPLETED/REJECTED,
    //               IN_PROGRESS → COMPLETED/REJECTED. COMPLETED must name a signed
    //               photo that was made for this request.
    function celebrityTakesRequestAt(celebrity, price) {
      return isVerifiedCelebrity(celebrity)
        && celebrity.get('isAcceptingRequests', true) != false
        && price == celebrity.get('autographPrice', 0);
    }

    function isValidRequestTransition(from, to) {
      return (from == 'PENDING' && to in ['ACCEPTED', 'REJECTED'])
        || (from == 'ACCEPTED' && to in ['IN_PROGRESS', 'COMPLETED', 'REJECTED'])
        || (from == 'IN_PROGRESS' && to in ['COMPLETED', 'REJECTED']);
    }

    function isPhotoForRequest(photoId, requestId) {
      return photoId is string
        && get(/databases/$(database)/documents/signed_photos/$(photoId)).data.get('requestId', null) == requestId;
    }

    match /autograph_requests/{requestId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.fanId
          || request.auth.uid == resource.data.celebrityId);

      allow create: if isSignedIn()
        && request.resource.data.fanId == request.auth.uid
        && request.resource.data.celebrityId != request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.id == requestId
        && request.resource.data.get('signedPhotoId', null) == null
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.celebrityId)/blocked/$(request.auth.uid))
        && celebrityTakesRequestAt(userDoc(request.resource.data.celebrityId),
                                   request.resource.data.price);

      allow update: if isSignedIn() && (

        // Fan cancels a pending request
        (request.auth.uid == resource.data.fanId
          && resource.data.status == 'PENDING'
          && request.resource.data.status == 'CANCELLED'
          && onlyChanges(['status', 'updatedAt']))

        ||

        // Celebrity manages the request workflow
        (request.auth.uid == resource.data.celebrityId
          && isValidRequestTransition(resource.data.status, request.resource.data.status)
          && onlyChanges(['status', 'signedPhotoId', 'updatedAt'])
          && (request.resource.data.status != 'COMPLETED'
            || isPhotoForRequest(request.resource.data.get('signedPhotoId', null), requestId)))
      );
    }

    // ── transactions/{transactionId} ──────────────────────────────────────────
    //
    // Only the buyer or seller can read a transaction (private financial records).
    //
    // A client can only record its own marketplace purchase of a photo that is
    // listed right now: seller and amount must match the listing as it stands
    // before the purchase commits (get() sees pre-commit state).
    // ⚠ The app currently writes COMPLETED status directly from the client with
    //   no payment gate. Move purchaseListing to a Cloud Function and restrict
    //   create to `false` here once that's in place.
    //
    // Updates and deletes are denied entirely — transactions are append-only.
    function matchesListing(tx, photo) {
      return photo.status == 'LISTED'
        && tx.sellerId == photo.ownerId
        && tx.amount == photo.price;
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.buyerId
          || request.auth.uid == resource.data.sellerId);

      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.id == transactionId
        && request.resource.data.type == 'MARKETPLACE_PURCHASE'
        && request.resource.data.relatedItemId is string
        && matchesListing(request.resource.data,
          get(/databases/$(database)/documents/signed_photos/$(request.resource.data.relatedItemId)).data);

      allow update, delete: if false;
    }
  }
}
