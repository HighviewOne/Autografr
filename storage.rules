rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Note: the app stores getDownloadUrl() links (…?token=…) in Firestore, and
    // those bypass these rules — `allow read` here only governs SDK reads.

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Client-generated UUID + .jpg — no arbitrary names or extensions.
    function isPhotoFileName(fileName) {
      return fileName.matches('[A-Za-z0-9-]{1,64}[.]jpg');
    }

    // JPEG only (the app always re-encodes to JPEG). Rejects SVG/HTML and other
    // types that could be served back as active content.
    function isJpegUnder(maxMb) {
      return request.resource.contentType == 'image/jpeg'
        && request.resource.size < maxMb * 1024 * 1024;
    }

    // ── profile_images/{userId}.jpg ───────────────────────────────────────────
    // Filename is the owner's uid. The app downscales avatars to ≤1024 px before
    // upload. Owners may replace or delete their own avatar.
    match /profile_images/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && fileName == request.auth.uid + '.jpg'
        && isJpegUnder(5);
      allow delete: if isSignedIn()
        && fileName == request.auth.uid + '.jpg';
    }

    // ── {original_photos,signed_photos,thumbnails}/{userId}/{photoId}.jpg ─────
    // All three are uploaded from the celebrity's canvas on save. The uploader's
    // uid is in the path, so only they can create or delete their objects.
    // Create-only: finished work can never be overwritten, even by its author
    // (every save uses a fresh photoId).
    match /original_photos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isPhotoFileName(fileName) && isJpegUnder(15);
      allow delete: if isOwner(userId);
    }

    match /signed_photos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isPhotoFileName(fileName) && isJpegUnder(15);
      allow delete: if isOwner(userId);
    }

    // The app uploads a ≤512 px copy here.
    match /thumbnails/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isPhotoFileName(fileName) && isJpegUnder(2);
      allow delete: if isOwner(userId);
    }

    // Everything else — including pre-2026-09 flat paths like signed_photos/{id}.jpg —
    // is denied. Existing objects there stay reachable through their stored
    // download-token URLs.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
